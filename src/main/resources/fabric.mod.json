{
	"schemaVersion": 1,
	"id": "raft",
	"version": "${version}",
	"name": "Raft",
	"description": "Adds a Raft dimension to Minecraft, inspired by the survival game Raft: floating debris, a hungry shark, driftwood and palm wood, titanium armor and machines, a portal and a lot of ocean.",
	"authors": [
		"Kasax"
	],
	"contact": {
		"homepage": "https://www.curseforge.com/minecraft/mc-mods/raft",
		"sources": "https://github.com/Kasax007/Kasax_Raft_Mod"
	},
	"license": "MIT",
	"icon": "assets/raft/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.kasax.raft.Raft"
		],
		"client": [
			"net.kasax.raft.RaftClient"
		],
		"fabric-datagen": [
			"net.kasax.raft.RaftDataGenerator"
		]
	},
	"mixins": [
		"raft.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
