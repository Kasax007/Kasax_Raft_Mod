{
	"schemaVersion": 1,
	"id": "raft",
	"version": "${version}",
	"name": "Beach Craft",
	"description": "Beach Craft (Raft): a whole ocean dimension to survive in. Build and sail rafts, dive to drowned cities and reefs, meet sharks, whales, crabs and stranger things, follow the story of the Tidewardens across islands and wrecks, and face the Leviathan at the bottom of the abyss.",
	"authors": [
		"Kasax"
	],
	"contact": {
		"homepage": "https://www.curseforge.com/minecraft/mc-mods/raft",
		"sources": "https://github.com/Kasax007/Kasax_Raft_Mod"
	},
	"license": "MIT",
	"icon": "assets/raft/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.kasax.raft.Raft"
		],
		"client": [
			"net.kasax.raft.RaftClient"
		],
		"fabric-datagen": [
			"net.kasax.raft.RaftDataGenerator"
		]
	},
	"mixins": [
		"raft.mixins.json",
		"raft-world.mixins.json",
		"raft-building.mixins.json",
		"raft-decor.mixins.json",
		"raft-shore.mixins.json",
		"raft-marine.mixins.json",
		"raft-voyage.mixins.json",
		"raft-diving.mixins.json",
		"raft-story.mixins.json",
		"raft-boss.mixins.json",
		"raft-guide.mixins.json",
		"raft-audio.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
